# App
APP_URL=http://localhost:3000
APP_NAME=Leadline
DRY_RUN=true
ENCRYPTION_KEY=                 # 32 bytes, base64: openssl rand -base64 32
WORKER_POLL_SECONDS=15
DEV_LOGIN=true                  # local only; ignored when NODE_ENV=production

# Database (Supabase: Project Settings → Database → Connection string, session pooler)
DATABASE_URL=postgres://postgres@127.0.0.1:54329/leadline

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Anthropic
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5-5
FAST_MODEL=claude-haiku-5-5

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_ALERT_NUMBER=            # platform number for rep alerts

# Postmark
POSTMARK_SERVER_TOKEN=
POSTMARK_SENDING_DOMAIN=
POSTMARK_INBOUND_DOMAIN=
POSTMARK_INBOUND_WEBHOOK_SECRET=
POSTMARK_TRANSACTIONAL_STREAM=outbound
POSTMARK_BROADCAST_STREAM=broadcast

# Meta
META_APP_ID=
META_APP_SECRET=
META_LOGIN_CONFIG_ID=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_VERSION=

# Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe (phase 5)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Monitoring
SENTRY_DSN=
